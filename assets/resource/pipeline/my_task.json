{
    // 示例任务链：OCR 识别 -> 模板匹配 -> OCR 选项 -> 自定义 Agent
    // 文档参考：https://maafw.com/docs/3.1-任务流水线协议

    // 任务 1：OCR 识别“开始游戏”并点击（低代码 JSON 方案）
    "StartTask": {
        "recognition": "OCR",
        "expected": "开始游戏",
        "action": "Click",
        "next": [
            "ConfirmTask"
        ]
    },
    // 任务 2：图像模板匹配“确认”按钮并点击
    "ConfirmTask": {
        "recognition": "TemplateMatch",
        "template": "confirm_button.png",
        "threshold": 0.7,
        "action": "Click",
        "next": [
            "OcrTask"
        ]
    },
    // 任务 3：OCR 选项任务，可通过界面选项切换识别文本（文本1 / 文本2）
    "OcrTask": {
        "recognition": "OCR",
        "expected": "文本1",
        "action": "Click",
        "next": [
            "CustomTask"
        ]
    },
    // 任务 4：自定义识别 + 自定义动作（由 agent/my_reco.py 与 agent/my_action.py 实现）
    "CustomTask": {
        "recognition": "Custom",
        "custom_recognition": "my_reco_222",
        "action": "Custom",
        "custom_action": "my_action_111"
    },
    // 补充示例：识别并点击关闭按钮
    "CloseTask": {
        "recognition": "TemplateMatch",
        "template": "close_icon.png",
        "action": "Click"
    },
    // agent 示例代码（my_reco.py）中 run_recognition 引用的 OCR 任务
    "MyCustomOCR": {
        "recognition": "OCR",
        "expected": ".*"
    }
}
