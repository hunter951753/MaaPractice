{
    // 第七史诗 (Epic Seven / E7) 自动化脚本 - 项目界面配置
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MaaPractice (第七史诗)",
    "description": "第七史诗 (Epic Seven) 自动脚本：自动刷商店、收邮件、日常任务，支持一键日常。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "欢迎使用第七史诗自动脚本！连接设备后选择任务开始。",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/hunter951753/MaaPractice",
    "version": "1.2.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                // 第七史诗 PC 客户端（STOVE 版）窗口匹配
                "class_regex": "GLFW30",
                "window_regex": ".*第七史诗.*",
                // 截图方式：实测 GDI 可正常截取游戏画面（PrintWindow 对 GPU 渲染窗口为黑屏）
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "GDI",
                // 鼠标用 PostMessage（直接携带窗口坐标发送，无需移动光标；
                // PostMessageWithCursorPos 需 SetCursorPos 移动光标，部分环境下受限）
                "mouse": "PostMessage",
                "keyboard": "PostMessage" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 启用 agent 进程，承载自定义识别/动作模块（agent/my_reco.py、agent/my_action.py）
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "一键日常（推荐）",
            "entry": "E7_OneKey"
        },
        {
            "name": "自动刷商店",
            "entry": "E7_Shop_Enter"
        },
        {
            "name": "收邮件",
            "entry": "E7_Mail_Enter"
        },
        {
            "name": "日常任务",
            "entry": "E7_Daily_Enter"
        }
    ]
}
