{
    // 第七史诗 (Epic Seven / E7) 自动化脚本 - 项目界面配置
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "MaaPractice (第七史诗)",
    "description": "第七史诗 (Epic Seven) 自动脚本：自动刷商店、领体力、收邮件、日常任务，支持一键日常。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "欢迎使用第七史诗自动脚本！连接设备后选择任务开始。",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/hunter951753/MaaPractice",
    "version": "1.1.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "Visual Studio",
                // 截图及控制方式，请根据项目实际情况修改
                // 文档: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截图方式
                "mouse": "PostMessageWithCursorPos", // 鼠标控制方式
                "keyboard": "PostMessageWithCursorPos" // 键盘控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 启用 agent 进程，承载自定义识别/动作模块（agent/my_reco.py、agent/my_action.py）
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "一键日常（推荐）",
            "entry": "E7_OneKey"
        },
        {
            "name": "自动刷商店",
            "entry": "E7_Shop_Enter"
        },
        {
            "name": "领商店体力",
            "entry": "E7_Energy_Enter"
        },
        {
            "name": "收邮件",
            "entry": "E7_Mail_Enter"
        },
        {
            "name": "日常任务",
            "entry": "E7_Daily_Enter"
        }
    ]
}
